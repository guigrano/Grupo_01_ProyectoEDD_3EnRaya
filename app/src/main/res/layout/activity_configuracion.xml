<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <ImageButton
        android:id="@+id/btnRegresarInicio"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_media_previous"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Regresar al inicio"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloConfig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="40dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elige tu símbolo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnX"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="X"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="#E74C3C"
                app:cornerRadius="12dp"
                android:layout_marginEnd="20dp"/>

            <Button
                android:id="@+id/btnO"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:text="O"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="#2980B9"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvQuienComienza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Quién comienza?"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"/>

        <RadioGroup
            android:id="@+id/rgTurno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbHumano"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yo"
                android:textSize="20sp"
                android:textColor="#2C3E50"/>

            <RadioButton
                android:id="@+id/rbComputadora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Computadora"
                android:textSize="20sp"
                android:textColor="#2C3E50"/>

        </RadioGroup>

        <Button
            android:id="@+id/btnContinuar"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:text="Jugar"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="#2C3E50"
            app:cornerRadius="16dp"
            android:layout_marginTop="40dp"/>

    </LinearLayout>
</RelativeLayout>