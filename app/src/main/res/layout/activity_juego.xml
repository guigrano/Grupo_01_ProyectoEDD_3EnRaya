<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Flecha para regresar -->
    <ImageButton
        android:id="@+id/btnRegresar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Regresar"
        android:src="@android:drawable/ic_media_previous" />

    <!-- Espacio superior -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- Tablero -->
    <GridLayout
        android:id="@+id/cuadriculaUI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:rowCount="3"
        android:columnCount="3">

        <Button
            android:id="@+id/casilla00"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text=""
            android:textSize="30sp" />

        <Button
            android:id="@+id/casilla01"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text=""
            android:textSize="30sp" />

        <Button
            android:id="@+id/casilla02"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text=""
            android:textSize="30sp" />

        <Button
            android:id="@+id/casilla10"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text=""
            android:textSize="30sp" />

        <Button
            android:id="@+id/casilla11"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text=""
            android:textSize="30sp" />

        <Button
            android:id="@+id/casilla12"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text=""
            android:textSize="30sp" />

        <Button
            android:id="@+id/casilla20"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text=""
            android:textSize="30sp" />

        <Button
            android:id="@+id/casilla21"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text=""
            android:textSize="30sp" />

        <Button
            android:id="@+id/casilla22"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text=""
            android:textSize="30sp" />

    </GridLayout>

    <!-- Estado del turno -->
    <TextView
        android:id="@+id/tvTurno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="25dp"
        android:text="Tu turno"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRecomendacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:text=""
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Resultado -->
    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:text=""
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Jugar de nuevo -->
    <Button
        android:id="@+id/btnJugarDeNuevo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:text="Jugar de nuevo"
        android:visibility="gone" />

</LinearLayout>