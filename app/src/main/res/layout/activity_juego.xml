<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Flecha para regresar -->
    <ImageButton
        android:id="@+id/btnRegresar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Regresar"
        android:src="@android:drawable/ic_media_previous" />

    <!-- Espacio superior que empuja el tablero hacia el centro -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Tablero -->
    <GridLayout
        android:id="@+id/cuadriculaUI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:background="#2C3E50"
        android:columnCount="3"
        android:rowCount="3">

        <!-- Fila 0 -->
        <Button android:id="@+id/casilla00"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_marginEnd="4dp" android:layout_marginBottom="4dp"
            app:backgroundTint="#FFFFFF" android:textColor="#2C3E50" android:textSize="50sp" android:textStyle="bold"
            app:cornerRadius="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"/>

        <Button android:id="@+id/casilla01"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_marginEnd="4dp" android:layout_marginBottom="4dp"
            app:backgroundTint="#FFFFFF" android:textColor="#2C3E50" android:textSize="50sp" android:textStyle="bold"
            app:cornerRadius="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"/>

        <Button android:id="@+id/casilla02"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_marginBottom="4dp"
            app:backgroundTint="#FFFFFF" android:textColor="#2C3E50" android:textSize="50sp" android:textStyle="bold"
            app:cornerRadius="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"/>

        <!-- Fila 1 -->
        <Button android:id="@+id/casilla10"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_marginEnd="4dp" android:layout_marginBottom="4dp"
            app:backgroundTint="#FFFFFF" android:textColor="#2C3E50" android:textSize="50sp" android:textStyle="bold"
            app:cornerRadius="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"/>

        <Button android:id="@+id/casilla11"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_marginEnd="4dp" android:layout_marginBottom="4dp"
            app:backgroundTint="#FFFFFF" android:textColor="#2C3E50" android:textSize="50sp" android:textStyle="bold"
            app:cornerRadius="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"/>

        <Button android:id="@+id/casilla12"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_marginBottom="4dp"
            app:backgroundTint="#FFFFFF" android:textColor="#2C3E50" android:textSize="50sp" android:textStyle="bold"
            app:cornerRadius="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"/>

        <!-- Fila 2 (No lleva margen inferior, así no hay línea abajo) -->
        <Button android:id="@+id/casilla20"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_marginEnd="4dp"
            app:backgroundTint="#FFFFFF" android:textColor="#2C3E50" android:textSize="50sp" android:textStyle="bold"
            app:cornerRadius="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"/>

        <Button android:id="@+id/casilla21"
            android:layout_width="100dp" android:layout_height="100dp"
            android:layout_marginEnd="4dp"
            app:backgroundTint="#FFFFFF" android:textColor="#2C3E50" android:textSize="50sp" android:textStyle="bold"
            app:cornerRadius="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"/>

        <Button android:id="@+id/casilla22"
            android:layout_width="100dp" android:layout_height="100dp"
            app:backgroundTint="#FFFFFF" android:textColor="#2C3E50" android:textSize="50sp" android:textStyle="bold"
            app:cornerRadius="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:insetLeft="0dp" android:insetRight="0dp"/>

    </GridLayout>

    <!-- Estado del turno -->
    <TextView
        android:id="@+id/tvTurno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="25dp"
        android:text="Tu turno"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Botones Deshacer / Rehacer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDeshacer"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="↩ Deshacer"
            android:textSize="14sp"
            android:textColor="@color/white"
            app:backgroundTint="#E74C3C"
            app:cornerRadius="12dp"
            android:layout_marginEnd="12dp"
            android:enabled="false"/>

        <Button
            android:id="@+id/btnRehacer"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Rehacer ↪"
            android:textSize="14sp"
            android:textColor="@color/white"
            app:backgroundTint="#1ABC9C"
            app:cornerRadius="12dp"
            android:enabled="false"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvRecomendacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:text=""
        android:textSize="18sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnPensamiento"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:text="Mostrar pensamiento de la computadora"
        android:textSize="14sp"
        android:textColor="@color/white"
        app:backgroundTint="#2980B9"
        app:cornerRadius="12dp" />

    <!-- Resultado -->
    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:text=""
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Jugar de nuevo -->
    <Button
        android:id="@+id/btnJugarDeNuevo"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:text="Jugar de nuevo"
        android:textSize="16sp"
        android:textColor="@color/white"
        app:backgroundTint="#27AE60"
        app:cornerRadius="12dp"
        android:visibility="gone" />

    <!-- Espacio inferior que empuja el tablero hacia el centro -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>